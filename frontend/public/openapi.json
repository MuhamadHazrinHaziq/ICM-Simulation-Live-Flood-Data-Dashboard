            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "title": "Response List Contour Timesteps Api V1 Contours Timesteps Get"
                }
              }
            }
          }
        }
      }
    },
